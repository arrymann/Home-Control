<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HomeControl.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HomeControl.Helpers"
    xmlns:local="using:HomeControl.Views"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Page.Resources>
        <!-- Disabled icon buttons (Move up on the first device...) stay borderless. -->
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />

        <!-- A device row (inside its room). -->
        <DataTemplate x:Key="DeviceTemplate" x:DataType="local:DeviceListItem">
            <toolkit:SettingsCard Description="{x:Bind Description}" Header="{x:Bind Label}">
                <toolkit:SettingsCard.HeaderIcon>
                    <PathIcon Data="{x:Bind helpers:Ui.DeviceIcon(Kind)}" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleSwitch
                        MinWidth="0"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Show in the tray"
                        IsOn="{x:Bind ShowInTray}"
                        OffContent=""
                        OnContent=""
                        Toggled="OnShowInTrayToggled"
                        ToolTipService.ToolTip="Show in the tray" />
                    <Button
                        AutomationProperties.Name="Move up"
                        Click="OnMoveUpClick"
                        IsEnabled="{x:Bind CanMoveUp}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Move up">
                        <FontIcon FontSize="14" Glyph="&#xE74A;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Move down"
                        Click="OnMoveDownClick"
                        IsEnabled="{x:Bind CanMoveDown}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Move down">
                        <FontIcon FontSize="14" Glyph="&#xE74B;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Edit"
                        Click="OnEditClick"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Edit">
                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Remove"
                        Click="OnRemoveClick"
                        IsEnabled="{x:Bind CanRemove}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind RemoveToolTip}">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </StackPanel>
            </toolkit:SettingsCard>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource SettingsPageMaxWidth}"
            Margin="36,24,36,36"
            Spacing="4">
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Devices" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Devices that can be turned on and off come from your Google Home. Choose which ones show in the tray, and give them a label, an icon and a shortcut."
                TextWrapping="Wrap" />

            <InfoBar
                x:Name="SignInInfo"
                Title="Not connected"
                IsClosable="False"
                Message="Sign in to Google Home so Home Control can load and switch your devices."
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button Click="OnSignInClick" Content="Sign in" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                x:Name="HotkeyInfo"
                Title="Some shortcuts don't work"
                Severity="Warning" />

            <toolkit:SettingsCard x:Name="SyncCard" Header="Google Home">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE80F;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing
                        x:Name="SyncProgress"
                        Width="16"
                        Height="16"
                        IsActive="False" />
                    <Button
                        x:Name="SyncButton"
                        Click="OnSyncClick"
                        Content="Sync now" />
                </StackPanel>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                Click="OnAddClick"
                Description="For scenes, or devices Google Home on the web can't switch. Uses Google Assistant (set it up on the Account page)."
                Header="Add a device by name"
                IsClickEnabled="True">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE710;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <TextBlock
                x:Name="ListHeader"
                Style="{StaticResource SettingsSectionHeaderStyle}"
                Text="Your devices" />
            <!-- Homes, each with collapsible rooms. The tray keeps its own order (Move up/down). -->
            <ItemsControl x:Name="HomeList" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="16" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DeviceHomeGroup">
                        <StackPanel Spacing="4">
                            <Button
                                Padding="8,6"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Click="OnHomeHeaderClick"
                                ToolTipService.ToolTip="{x:Bind ToggleText, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontSize="12" Glyph="{x:Bind Chevron, Mode=OneWay}" />
                                    <FontIcon FontSize="16" Glyph="&#xE80F;" />
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Count}" />
                                </StackPanel>
                            </Button>
                            <ItemsControl
                                IsTabStop="False"
                                ItemsSource="{x:Bind Rooms}"
                                Visibility="{x:Bind RoomsVisibility, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:DeviceRoomGroup">
                                        <toolkit:SettingsExpander
                                            Description="{x:Bind Description}"
                                            Header="{x:Bind Title}"
                                            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                            ItemTemplate="{StaticResource DeviceTemplate}"
                                            ItemsSource="{x:Bind Devices}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
