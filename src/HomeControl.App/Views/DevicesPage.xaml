<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HomeControl.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HomeControl.Helpers"
    xmlns:local="using:HomeControl.Views"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Page.Resources>
        <!-- Disabled icon buttons (Move up on the first device...) stay borderless. -->
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource SettingsPageMaxWidth}"
            Margin="36,24,36,36"
            Spacing="4">
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Devices" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Home Control switches devices through Google Assistant, the same way as saying “Hey Google, turn on the kitchen light”. Add each device with the name it has in the Google Home app."
                TextWrapping="Wrap" />

            <InfoBar
                x:Name="SignInInfo"
                Title="Not signed in"
                IsClosable="False"
                Message="Connect your Google account so Home Control can switch these devices."
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button Click="OnGoToAccountClick" Content="Go to Account" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                x:Name="HotkeyInfo"
                Title="Some shortcuts don't work"
                Severity="Warning" />

            <toolkit:SettingsCard
                Click="OnAddClick"
                Description="Lights, plugs, switches, TVs, scenes – anything Google Home can turn on and off."
                Header="Add a device"
                IsClickEnabled="True">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE710;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <TextBlock
                x:Name="ListHeader"
                Style="{StaticResource SettingsSectionHeaderStyle}"
                Text="Your devices" />
            <ItemsControl x:Name="DeviceList" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DeviceListItem">
                        <toolkit:SettingsCard Description="{x:Bind Description}" Header="{x:Bind Label}">
                            <toolkit:SettingsCard.HeaderIcon>
                                <PathIcon Data="{x:Bind helpers:Ui.DeviceIcon(Kind)}" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button
                                    AutomationProperties.Name="Move up"
                                    Click="OnMoveUpClick"
                                    IsEnabled="{x:Bind CanMoveUp}"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="Move up">
                                    <FontIcon FontSize="14" Glyph="&#xE74A;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Move down"
                                    Click="OnMoveDownClick"
                                    IsEnabled="{x:Bind CanMoveDown}"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="Move down">
                                    <FontIcon FontSize="14" Glyph="&#xE74B;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Edit"
                                    Click="OnEditClick"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="Edit">
                                    <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Remove"
                                    Click="OnRemoveClick"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="Remove">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                </Button>
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
