<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HomeControl.Views.GoogleSignInWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sign in to Google Home">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="SolidBackground"
            Grid.RowSpan="3"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Visibility="Collapsed" />

        <Grid
            x:Name="AppTitleBar"
            Padding="16,0,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                x:Name="TitleBarIcon"
                Width="16"
                Height="16"
                VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Sign in to Google Home" />
        </Grid>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            Margin="12,0,12,8"
            IsClosable="False"
            IsOpen="True"
            Message="Sign in with the Google account that has your home. Home Control only uses this session to list and switch your devices; it never sees your password."
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button
                    x:Name="DoneButton"
                    Click="OnDoneClick"
                    Content="Done"
                    Visibility="Collapsed" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="2">
            <WebView2 x:Name="Browser" />
            <ProgressRing
                x:Name="LoadingRing"
                Width="32"
                Height="32"
                IsActive="True" />
        </Grid>
    </Grid>
</Window>
