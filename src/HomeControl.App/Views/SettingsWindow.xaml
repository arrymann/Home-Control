<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HomeControl.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Home Control settings">

    <Grid x:Name="Root">
        <!-- Shown only when the window material is turned off. -->
        <Border x:Name="SolidBackground" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Visibility="Collapsed" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="AppTitleBar"
                Padding="16,0,0,0"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    x:Name="TitleBarIcon"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Home Control settings" />
            </Grid>

            <NavigationView
                x:Name="Navigation"
                Grid.Row="1"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                ItemInvoked="OnNavigationItemInvoked"
                OpenPaneLength="220"
                PaneDisplayMode="Left"
                SelectionChanged="OnNavigationSelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Devices" Tag="devices">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Scenes" Tag="scenes">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8A9;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Automations" Tag="automations">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE945;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Account" Tag="account">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE77B;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="General" Tag="general">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- A page that didn't open says why, instead of leaving the last one up without a word. -->
                    <InfoBar
                        x:Name="PageErrorBar"
                        Margin="36,12,36,0"
                        IsClosable="False"
                        Severity="Error"
                        Title="This page didn't open"
                        Visibility="Collapsed" />
                    <Frame
                        x:Name="ContentFrame"
                        Grid.Row="1"
                        NavigationFailed="OnNavigationFailed" />
                </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
