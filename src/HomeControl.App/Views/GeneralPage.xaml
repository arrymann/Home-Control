<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HomeControl.Views.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HomeControl.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource SettingsPageMaxWidth}"
            Margin="36,24,36,36"
            Spacing="4">
            <TextBlock
                Margin="0,0,0,16"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="General" />

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Margin="1,0,0,6" Text="Appearance" />
            <toolkit:SettingsCard Description="The tray icon always matches your taskbar." Header="App theme">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeBox" MinWidth="200" SelectionChanged="OnThemeChanged">
                    <ComboBoxItem Content="Use Windows setting" Tag="System" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Description="Mica tints the windows with your desktop background (Windows 11)." Header="Window material">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE771;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="BackdropBox" MinWidth="200" SelectionChanged="OnBackdropChanged">
                    <ComboBoxItem Content="Mica" Tag="Mica" />
                    <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                    <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                    <ComboBoxItem Content="None" Tag="None" />
                </ComboBox>
            </toolkit:SettingsCard>

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Shortcuts" />
            <toolkit:SettingsCard Description="Opens the device popup from anywhere. Device shortcuts are set on the Devices page." Header="Open Home Control">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE765;" />
                </toolkit:SettingsCard.HeaderIcon>
                <controls:ShortcutRecorder x:Name="PopupShortcut" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Description="Confirms what happened when you use a device shortcut." Header="Show a notification after a shortcut">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEA8F;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="NotifySwitch" Toggled="OnNotifyToggled" />
            </toolkit:SettingsCard>

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Behavior" />
            <toolkit:SettingsCard Description="Google Home devices are always checked. This also asks Google Assistant about each device added by name – slower, one question per device." Header="Check Google Assistant devices when opening">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE72C;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="RefreshSwitch" Toggled="OnRefreshToggled" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Description="Starts in the tray when you sign in to Windows." Header="Start with Windows">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="StartupSwitch" Toggled="OnStartupToggled" />
            </toolkit:SettingsCard>

            <TextBlock x:Name="ClapHeader" Style="{StaticResource SettingsSectionHeaderStyle}" Text="Clap listening" />
            <toolkit:SettingsExpander x:Name="ClapExpander" Header="Listen for claps">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE720;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <ToggleSwitch x:Name="ClapSwitch" Toggled="OnClapToggled" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Description="Higher also hears quieter claps from further away, but takes more other sounds for claps." Header="Sensitivity">
                        <ComboBox x:Name="ClapSensitivityBox" MinWidth="200" SelectionChanged="OnClapSensitivityChanged">
                            <ComboBoxItem Content="Low" Tag="Low" />
                            <ComboBoxItem Content="Medium" Tag="Medium" />
                            <ComboBoxItem Content="High" Tag="High" />
                        </ComboBox>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Description="The Windows default recording device, unless you pick one." Header="Microphone">
                        <ComboBox x:Name="MicrophoneBox" MinWidth="200" MaxWidth="320" SelectionChanged="OnMicrophoneChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Description="Closes the microphone while the PC is locked." Header="Pause while the PC is locked">
                        <ToggleSwitch x:Name="ClapLockSwitch" Toggled="OnClapLockToggled" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        Click="OnMicrophonePrivacyClick"
                        Description="Windows decides whether desktop apps may use the microphone, and shows an icon while one does."
                        Header="Windows microphone privacy settings"
                        IsClickEnabled="True">
                        <toolkit:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </toolkit:SettingsCard.ActionIcon>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard ContentAlignment="Left">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No sound is kept. It is analysed as it arrives, 10 ms at a time, and reduced to two loudness figures; the sound itself is never recorded, saved, logged or sent anywhere. The microphone is open only while this is on and an enabled automation has a Claps trigger (Automations page)."
                            TextWrapping="Wrap" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
            <InfoBar
                x:Name="ClapBlockedBar"
                Title="Microphone blocked"
                IsClosable="False"
                Message="Windows doesn't let desktop apps use the microphone. Turn on “Let desktop apps access your microphone”, then try again."
                Severity="Warning">
                <InfoBar.ActionButton>
                    <Button Click="OnMicrophonePrivacyClick" Content="Open privacy settings" />
                </InfoBar.ActionButton>
                <HyperlinkButton Margin="0,0,0,8" Click="OnClapRetryClick" Content="Try again" />
            </InfoBar>

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="About" />
            <toolkit:SettingsExpander x:Name="AboutExpander" Header="Home Control">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE80F;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Description="Settings, encrypted sign-in data and the log file." Header="Data folder">
                        <Button Click="OnOpenDataFolderClick" Content="Open folder" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard ContentAlignment="Left">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Devices are switched through Google Home on the web (home.google.com) and, optionally, the Google Assistant API (google.assistant.embedded.v1alpha2). Not affiliated with Google. Icons: Fluent UI System Icons, MIT license."
                            TextWrapping="Wrap" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
