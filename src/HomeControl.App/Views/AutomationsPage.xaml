<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HomeControl.Views.AutomationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HomeControl.Controls"
    xmlns:local="using:HomeControl.Views"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Grid>
        <!-- The list of automations, the location and "new automation". -->
        <ScrollViewer x:Name="ListPane">
            <StackPanel
                MaxWidth="{StaticResource SettingsPageMaxWidth}"
                Margin="36,24,36,36"
                Spacing="4">
                <TextBlock
                    Margin="0,0,0,8"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Automations" />
                <TextBlock
                    Margin="0,0,0,16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Let devices switch on their own: at a time of day, at sunrise, sunset or twilight, when the PC is locked, wakes up or sits idle, or when Windows shuts down. Each automation is a small graph of nodes: a trigger (when), optional conditions (if) and actions (then)."
                    TextWrapping="Wrap" />

                <toolkit:SettingsExpander x:Name="LocationExpander" Header="Location">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE81D;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing
                            x:Name="LocationProgress"
                            Width="16"
                            Height="16"
                            IsActive="False" />
                        <Button
                            x:Name="UseMyLocationButton"
                            Click="OnUseMyLocationClick"
                            Content="Use this PC's location" />
                    </StackPanel>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard Description="Type a town or city and pick it from the list." Header="Find a place">
                            <AutoSuggestBox
                                x:Name="PlaceBox"
                                Width="320"
                                PlaceholderText="Town or city"
                                QueryIcon="Find"
                                QuerySubmitted="OnPlaceSubmitted"
                                SuggestionChosen="OnPlaceChosen"
                                TextChanged="OnPlaceTextChanged" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Description="Degrees; north and east are positive." Header="Coordinates">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox
                                    x:Name="LatitudeBox"
                                    Width="130"
                                    Maximum="90"
                                    Minimum="-90"
                                    PlaceholderText="Latitude" />
                                <NumberBox
                                    x:Name="LongitudeBox"
                                    Width="130"
                                    Maximum="180"
                                    Minimum="-180"
                                    PlaceholderText="Longitude" />
                                <Button Click="OnSaveCoordinatesClick" Content="Save" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <InfoBar x:Name="LocationMessage" Severity="Warning" />

                <toolkit:SettingsCard Description="Start from scratch or from an example." Header="New automation">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE710;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <DropDownButton x:Name="NewButton" Content="Create" />
                </toolkit:SettingsCard>

                <TextBlock
                    x:Name="ListHeader"
                    Style="{StaticResource SettingsSectionHeaderStyle}"
                    Text="Your automations" />
                <ItemsControl x:Name="AutomationList" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:AutomationListItem">
                            <toolkit:SettingsCard
                                Click="OnEditClick"
                                Description="{x:Bind Description}"
                                Header="{x:Bind Name}"
                                IsClickEnabled="True">
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="{x:Bind Glyph}" />
                                </toolkit:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        MaxWidth="220"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Status}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Status}" />
                                    <ToggleSwitch
                                        MinWidth="0"
                                        AutomationProperties.Name="Enabled"
                                        IsOn="{x:Bind Enabled}"
                                        OffContent=""
                                        OnContent=""
                                        Toggled="OnEnabledToggled" />
                                    <Button
                                        AutomationProperties.Name="Delete"
                                        Click="OnDeleteClick"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTipService.ToolTip="Delete">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </toolkit:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    x:Name="EmptyText"
                    Margin="1,8,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No automations yet. Create one above – the examples are a good start."
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- The node editor for one automation. -->
        <Grid
            x:Name="EditorPane"
            Padding="24,16,24,20"
            RowSpacing="8"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    AutomationProperties.Name="Back to automations"
                    Click="OnBackClick"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Back to automations">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                </Button>
                <TextBox
                    x:Name="NameBox"
                    Grid.Column="1"
                    MaxWidth="360"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Name"
                    PlaceholderText="Name"
                    TextChanged="OnNameChanged" />
                <ToggleSwitch
                    x:Name="EnabledSwitch"
                    Grid.Column="2"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Enabled"
                    OffContent="Off"
                    OnContent="On"
                    Toggled="OnEditorEnabledToggled" />
                <DropDownButton
                    x:Name="AddNodeButton"
                    Grid.Column="3"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Add node" />
                    </StackPanel>
                </DropDownButton>
                <Button
                    x:Name="RunButton"
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Click="OnRunClick"
                    ToolTipService.ToolTip="Run now from a trigger (waits are skipped)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                        <TextBlock Text="Run now" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="UndoButton"
                    Grid.Column="5"
                    AutomationProperties.Name="Undo"
                    Click="OnUndoClick"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                </Button>
                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Button
                        AutomationProperties.Name="Zoom out"
                        Click="OnZoomOutClick"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Zoom out">
                        <FontIcon FontSize="14" Glyph="&#xE71F;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Zoom in"
                        Click="OnZoomInClick"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Zoom in">
                        <FontIcon FontSize="14" Glyph="&#xE8A3;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Fit to window"
                        Click="OnFitClick"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Show everything">
                        <FontIcon FontSize="14" Glyph="&#xE740;" />
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar
                x:Name="IssuesBar"
                Grid.Row="1"
                IsClosable="False" />
            <InfoBar x:Name="RunBar" Grid.Row="2" />

            <Border Grid.Row="3" Style="{StaticResource NodeCanvasStyle}">
                <controls:NodeCanvas x:Name="GraphCanvas" />
            </Border>

            <TextBlock
                Grid.Row="4"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Drag from a dot on the right of a node to the dot on the left of another to connect them · drop a wire on empty space to add a node there · right-click the canvas to add a node · click a wire and press Delete to remove it · drag the background to move around, Ctrl+wheel to zoom."
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Page>
