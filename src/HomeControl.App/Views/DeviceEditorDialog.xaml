<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="HomeControl.Views.DeviceEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HomeControl.Controls"
    xmlns:local="using:HomeControl.Views"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="Save"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel MinWidth="440" Spacing="16">
        <TextBox
            x:Name="NameBox"
            Header="Name in Google Home"
            PlaceholderText="e.g. Kitchen light"
            TextChanged="OnNameChanged" />

        <TextBox
            x:Name="LabelBox"
            Header="Label in Home Control (optional)"
            PlaceholderText="Same as the name" />

        <ComboBox
            x:Name="KindBox"
            HorizontalAlignment="Stretch"
            Header="Icon">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:KindOption">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Viewbox Width="16" Height="16">
                            <PathIcon Data="{x:Bind Icon}" />
                        </Viewbox>
                        <TextBlock Text="{x:Bind Name}" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel Spacing="8">
            <TextBlock Text="Shortcut" />
            <controls:ShortcutRecorder x:Name="ShortcutBox" />
        </StackPanel>

        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Custom commands">
            <StackPanel Spacing="12">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Leave empty to use the defaults from the Account page. {name} is replaced with the Google Home name. Handy for scenes, e.g. “activate movie night”."
                    TextWrapping="Wrap" />
                <TextBox x:Name="OnCommandBox" Header="Turn on with" />
                <TextBox x:Name="OffCommandBox" Header="Turn off with" />
                <TextBox x:Name="StateQueryBox" Header="Ask the state with" />
            </StackPanel>
        </Expander>

        <StackPanel Spacing="8">
            <TextBlock Text="Try it" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="TestOnButton" Click="OnTestOnClick" Content="Turn on" />
                <Button x:Name="TestOffButton" Click="OnTestOffClick" Content="Turn off" />
                <Button x:Name="TestStateButton" Click="OnTestStateClick" Content="Check state" />
                <ProgressRing
                    x:Name="TestProgress"
                    Width="16"
                    Height="16"
                    IsActive="False" />
            </StackPanel>
            <TextBlock
                x:Name="TestResult"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextSelectionEnabled="True"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock
            x:Name="ErrorText"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
